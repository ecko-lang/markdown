# markdown: Markdown in, structure out.
#
# A block-level parser aimed at what a docs pipeline or a RAG ingest actually
# does with Markdown: find the headings, pull out the code, read the tables,
# get clean text to embed. It is deliberately not a CommonMark implementation
# - see the README for what that means and where it will disagree.

import std.str

# ---------------------------------------------------------------- inline ---

fn is_fence(line) {
    t = str.trim(line)
    str.starts_with(t, "```") or str.starts_with(t, "~~~")
}

fn fence_lang(line) {
    t = str.trim(line)
    rest = if str.starts_with(t, "```") { str.substring(t, 3) } else { str.substring(t, 3) }
    str.trim(rest)
}

fn heading_level(line) {
    mut n = 0
    mut i = 0
    while i < str.len(line) and str.char_at(line, i) == "#" {
        n = n + 1
        i = i + 1
    }
    # ATX requires a space after the hashes, and caps at six.
    if n == 0 or n > 6 { return 0 }
    if i >= str.len(line) { return 0 }
    if str.char_at(line, i) != " " { return 0 }
    n
}

fn is_rule(line) {
    t = str.replace(str.trim(line), " ", "")
    if str.len(t) < 3 { return false }
    every_char_is(t, "-") or every_char_is(t, "*") or every_char_is(t, "_")
}

fn every_char_is(s, c) {
    str.chars(s) |> all(fn(ch) ch == c)
}

fn bullet_of(line) {
    t = str.trim_start(line)
    for marker in ["- ", "* ", "+ "] {
        if str.starts_with(t, marker) { return str.substring(t, 2) }
    }
    null
}

fn ordered_of(line) {
    t = str.trim_start(line)
    let (digits, dot, rest) = str.partition(t, ". ")
    if dot == "" { return null }
    if str.is_empty(digits) or not str.is_digit(digits) { return null }
    rest
}

fn is_table_sep(line) {
    t = str.trim(line)
    if not str.contains(t, "-") { return false }
    if not str.contains(t, "|") { return false }
    str.chars(t) |> all(fn(ch) ch == "|" or ch == "-" or ch == ":" or ch == " ")
}

fn split_row(line) {
    t = str.trim(str.trim_prefix(str.trim(line), "|"))
    t = str.trim_suffix(t, "|")
    str.split(t, "|") |> map(fn(c) str.trim(c))
}

# ----------------------------------------------------------------- parse ---

## Parse Markdown into a list of block maps.
##
## Every block has a `kind`, and the fields that go with it:
##
## - `heading`   -> `level` (1-6), `text`
## - `paragraph` -> `text`
## - `code`      -> `lang` (may be ""), `code`
## - `list`      -> `ordered` (bool), `items` (list of strings)
## - `table`     -> `headers` (list), `rows` (list of lists)
## - `quote`     -> `text`
## - `rule`      -> no extra fields
##
## Blocks come back in document order, so `parse` then a `for` loop is the
## whole walking story - there is no separate visitor to learn.
export fn parse(src) {
    lines = str.lines(src)
    mut blocks = []
    mut i = 0
    mut para = []

    fn flush(blocks, para) {
        if len(para) == 0 { return blocks }
        push(blocks, { kind: "paragraph", text: str.join(para, " ") })
    }

    while i < len(lines) {
        line = lines[i]
        t = str.trim(line)

        if str.is_blank(line) {
            blocks = flush(blocks, para)
            para = []
            i = i + 1
            continue
        }

        # Fenced code: everything to the closing fence is literal, including
        # blank lines and anything that would otherwise look like Markdown.
        if is_fence(line) {
            blocks = flush(blocks, para)
            para = []
            lang = fence_lang(line)
            mut body = []
            mut j = i + 1
            while j < len(lines) and not is_fence(lines[j]) {
                body = push(body, lines[j])
                j = j + 1
            }
            blocks = push(blocks, { kind: "code", lang: lang, code: str.join(body, "\n") })
            i = if j < len(lines) { j + 1 } else { j }
            continue
        }

        level = heading_level(t)
        if level > 0 {
            blocks = flush(blocks, para)
            para = []
            title = str.trim(str.trim_end(str.substring(t, level + 1), "#"))
            blocks = push(blocks, { kind: "heading", level: level, text: title })
            i = i + 1
            continue
        }

        # A rule has to be tested before a bullet list: `- - -` is a rule, and
        # `---` is not a one-item list.
        if is_rule(t) {
            blocks = flush(blocks, para)
            para = []
            blocks = push(blocks, { kind: "rule" })
            i = i + 1
            continue
        }

        # A table needs its separator row to be a table at all, which is what
        # keeps a paragraph containing a pipe from being read as one.
        if str.contains(t, "|") and i + 1 < len(lines) and is_table_sep(lines[i + 1]) {
            blocks = flush(blocks, para)
            para = []
            headers = split_row(t)
            mut rows = []
            mut j = i + 2
            while j < len(lines) and str.contains(lines[j], "|") and not str.is_blank(lines[j]) {
                rows = push(rows, split_row(lines[j]))
                j = j + 1
            }
            blocks = push(blocks, { kind: "table", headers: headers, rows: rows })
            i = j
            continue
        }

        if str.starts_with(t, "> ") or t == ">" {
            blocks = flush(blocks, para)
            para = []
            mut body = []
            mut j = i
            while j < len(lines) and str.starts_with(str.trim(lines[j]), ">") {
                body = push(body, str.trim(str.trim_prefix(str.trim(lines[j]), ">")))
                j = j + 1
            }
            blocks = push(blocks, { kind: "quote", text: str.join(body, " ") })
            i = j
            continue
        }

        item = bullet_of(line)
        onum = ordered_of(line)
        if item != null or onum != null {
            blocks = flush(blocks, para)
            para = []
            ordered = onum != null
            mut items = []
            mut j = i
            while j < len(lines) {
                nxt = if ordered { ordered_of(lines[j]) } else { bullet_of(lines[j]) }
                if nxt == null { break }
                items = push(items, str.trim(nxt))
                j = j + 1
            }
            blocks = push(blocks, { kind: "list", ordered: ordered, items: items })
            i = j
            continue
        }

        para = push(para, t)
        i = i + 1
    }
    flush(blocks, para)
}

# ------------------------------------------------------------------ html ---

fn escape(s) {
    s
        |> str.replace("&", "&amp;")
        |> str.replace("<", "&lt;")
        |> str.replace(">", "&gt;")
        |> str.replace("\"", "&quot;")
}

# Inline spans, applied to already-escaped text so a document can never inject
# markup. Deliberately small: code, bold, italic, links. Anything else is left
# as the literal characters the author wrote.
fn inline(s) {
    mut out = escape(s)
    out = wrap_pairs(out, "`", "<code>", "</code>")
    out = wrap_pairs(out, "**", "<strong>", "</strong>")
    # Any `**` still here is unmatched, and the single-`*` pass below would
    # read it as two markers and emit an empty `<em></em>` - losing the
    # characters the author actually typed. Park them somewhere `*` cannot
    # see, then put them back.
    guard = str.chr(1)
    out = str.replace(out, "**", guard)
    out = wrap_pairs(out, "*", "<em>", "</em>")
    out = str.replace(out, guard, "**")
    links(out)
}

fn wrap_pairs(s, marker, open, close) {
    parts = str.split(s, marker)
    # An odd marker count means the last one never closed; leave it literal
    # rather than inventing a tag the author did not write.
    if len(parts) < 3 or len(parts) % 2 == 0 { return s }
    mut out = ""
    mut i = 0
    for p in parts {
        out = if i == 0 { p } else if i % 2 == 1 { out + open + p + close } else { out + p }
        i = i + 1
    }
    out
}

# Which link targets become an `href`.
#
# A renderer that emits whatever it was given hands the document a script
# execution primitive: `[click](javascript:alert(1))` is the standard example,
# and `data:` and `vbscript:` are the same trick. Anything without a scheme is
# a relative link and is fine; a scheme has to be one we know is inert.
#
# A refused target is not silently dropped - the link text is still rendered,
# just as plain text, so the reader sees the words and not a live link.
fn safe_url(url) {
    let (scheme, colon, _rest) = str.partition(url, ":")
    if colon == "" { return true }
    # `/path:with:colons` and `#frag` have no scheme; a real one cannot
    # contain a slash, a space or a hash before its colon.
    if str.contains(scheme, "/") or str.contains(scheme, " ") or str.contains(scheme, "#") {
        return true
    }
    lower = str.lower(scheme)
    lower == "http" or lower == "https" or lower == "mailto"
}

fn links(s) {
    mut out = ""
    mut rest = s
    while true {
        let (before, open, after) = str.partition(rest, "](")
        if open == "" { return out + rest }
        idx = str.last_index_of(before, "[")
        if idx < 0 { return out + rest }
        let (url, close, tail) = str.partition(after, ")")
        if close == "" { return out + rest }
        label = str.substring(before, idx + 1)
        anchor = if safe_url(url) { "<a href=\"" + url + "\">" + label + "</a>" } else { label }
        out = out + str.substring(before, 0, idx) + anchor
        rest = tail
    }
    out
}

## Render Markdown to HTML.
##
## Text is HTML-escaped before any tag is added, so a document cannot inject
## markup - `<script>` in the source comes out as `&lt;script&gt;`, including
## inside code blocks and link text.
export fn to_html(src) {
    parse(src)
        |> map(block_html)
        |> join("\n")
}

fn block_html(b) {
    kind = get(b, "kind")
    if kind == "heading" {
        h = "h" + string(get(b, "level"))
        return "<" + h + ">" + inline(get(b, "text")) + "</" + h + ">"
    }
    if kind == "paragraph" { return "<p>" + inline(get(b, "text")) + "</p>" }
    if kind == "quote" { return "<blockquote>" + inline(get(b, "text")) + "</blockquote>" }
    if kind == "rule" { return "<hr>" }
    if kind == "code" {
        lang = get(b, "lang")
        attr = if lang == "" { "" } else { " class=\"language-" + escape(lang) + "\"" }
        return "<pre><code" + attr + ">" + escape(get(b, "code")) + "</code></pre>"
    }
    if kind == "list" {
        tag = if get(b, "ordered") { "ol" } else { "ul" }
        items = get(b, "items")
            |> map(fn(it) "<li>" + inline(it) + "</li>")
            |> join("")
        return "<" + tag + ">" + items + "</" + tag + ">"
    }
    if kind == "table" {
        head = get(b, "headers")
            |> map(fn(c) "<th>" + inline(c) + "</th>")
            |> join("")
        body = get(b, "rows")
            |> map(
                fn(r) "<tr>" + (r |> map(fn(c) "<td>" + inline(c) + "</td>") |> join("")) + "</tr>",
            )
            |> join("")
        return "<table><thead><tr>" + head + "</tr></thead><tbody>" + body + "</tbody></table>"
    }
    ""
}

# -------------------------------------------------------------- extracts ---

## Every heading, as `{ level, text }`, in document order.
##
## The shape a table of contents or a doc-structure check wants.
export fn headings(src) {
    parse(src)
        |> filter(fn(b) get(b, "kind") == "heading")
        |> map(fn(b) ({ level: get(b, "level"), text: get(b, "text") }))
}

## Every fenced code block, as `{ lang, code }`.
##
## `lang` is whatever followed the fence, or `""` when the fence was bare -
## so filtering by language is `filter(fn(c) c.lang == "ecko")`.
export fn code_blocks(src) {
    parse(src)
        |> filter(fn(b) get(b, "kind") == "code")
        |> map(fn(b) ({ lang: get(b, "lang"), code: get(b, "code") }))
}

## Every table, as `{ headers, rows }`.
##
## A table needs the `|---|` separator row under its header to be recognised,
## which is what keeps a paragraph that happens to contain a pipe from being
## read as one.
export fn tables(src) {
    parse(src)
        |> filter(fn(b) get(b, "kind") == "table")
        |> map(fn(b) ({ headers: get(b, "headers"), rows: get(b, "rows") }))
}

## The document as plain text, with the markup removed.
##
## For embedding and search: headings, paragraphs, list items, quotes and
## table cells come through as text, and code blocks are dropped - a vector of
## a code sample rarely answers the question someone asked in prose. Use
## `code_blocks` when you want those.
export fn text(src) {
    parse(src)
        |> map(block_text)
        |> filter(fn(s) s != "")
        |> join("\n\n")
}

fn block_text(b) {
    kind = get(b, "kind")
    if kind == "heading" or kind == "paragraph" or kind == "quote" {
        return strip_inline(get(b, "text"))
    }
    if kind == "list" {
        return get(b, "items")
            |> map(strip_inline)
            |> join("\n")
    }
    if kind == "table" {
        head = get(b, "headers")
            |> map(strip_inline)
            |> join(" ")
        # Braces on the closure body: `fn(r) r |> map(..)` parses as
        # `(fn(r) r) |> map(..)`, because `|>` binds loosest and an
        # expression-bodied closure ends before it.
        body = get(b, "rows")
            |> map(fn(r) {
                r
                    |> map(strip_inline)
                    |> join(" ")
            })
            |> join("\n")
        return if body == "" { head } else { head + "\n" + body }
    }
    ""
}

fn strip_inline(s) {
    mut out = s
    for marker in ["**", "*", "`", "_"] {
        out = str.replace(out, marker, "")
    }
    # `[text](url)` keeps the text and loses the target.
    mut result = ""
    mut rest = out
    while true {
        let (before, open, after) = str.partition(rest, "](")
        if open == "" { return str.trim(result + rest) }
        idx = str.last_index_of(before, "[")
        if idx < 0 { return str.trim(result + rest) }
        let (_url, close, tail) = str.partition(after, ")")
        if close == "" { return str.trim(result + rest) }
        result = result + str.substring(before, 0, idx) + str.substring(before, idx + 1)
        rest = tail
    }
    str.trim(result)
}

## Split a document into `{ heading, level, body }` sections, one per heading.
##
## This is the chunking a RAG ingest wants: each section carries the heading it
## sits under, so a retrieved chunk knows what it is about. Text before the
## first heading comes back with an empty `heading` and level `0` rather than
## being dropped.
export fn sections(src) {
    blocks = parse(src)
    mut out = []
    mut current = { heading: "", level: 0, blocks: [] }
    for b in blocks {
        if get(b, "kind") == "heading" {
            if len(get(current, "blocks")) > 0 or get(current, "heading") != "" {
                out = push(out, finish_section(current))
            }
            current = { heading: get(b, "text"), level: get(b, "level"), blocks: [] }
        } else {
            current = {
                heading: get(current, "heading"),
                level: get(current, "level"),
                blocks: push(get(current, "blocks"), b),
            }
        }
    }
    if len(get(current, "blocks")) > 0 or get(current, "heading") != "" {
        out = push(out, finish_section(current))
    }
    out
}

fn finish_section(c) {
    body = get(c, "blocks")
        |> map(block_text)
        |> filter(fn(s) s != "")
        |> join("\n\n")
    { heading: get(c, "heading"), level: get(c, "level"), body: body }
}
